# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env.local y completa los valores.
#   Local:  npx supabase status   (muestra la URL y las claves)
#   Nube:   panel de Supabase → Project Settings → API Keys / Data API
# ─────────────────────────────────────────────────────────────────────────────

# ── App (navegador) ──────────────────────────────────────────────────────────
# Estas dos son públicas: van dentro de la app y las protege RLS.
# Local en el PC: http://127.0.0.1:54321
# Local desde el móvil (misma Wi-Fi): http://<IP-de-tu-PC>:54321
# Nube: https://<ref-del-proyecto>.supabase.co
VITE_SUPABASE_URL=

# Clave pública: "anon" (legacy) o "publishable" (sb_publishable_...).
VITE_SUPABASE_ANON_KEY=

# ── Solo para `npm run seed` (nunca con prefijo VITE_, nunca en Vercel) ──────
# Si SUPABASE_URL falta, el seed usa VITE_SUPABASE_URL.
# SUPABASE_URL=
# Clave "service_role" (legacy) o "secret" (sb_secret_...). Salta RLS: trátala como contraseña.
SUPABASE_SERVICE_ROLE_KEY=

# ── Tutor IA: secretos de la Edge Function «tutor» (nunca con prefijo VITE_) ─────
# NO van en .env.local ni en Vercel:
#   Local: copia estas líneas a supabase/functions/.env (lo lee `npx supabase functions serve`).
#   Nube:  npx supabase secrets set --env-file supabase/functions/.env
#
# Proveedor: gemini (por defecto) o anthropic. «demo» responde textos fijos sin clave ni costo
# (solo para probar en local).
TUTOR_PROVIDER=gemini
# Modelo. Vacío = el por defecto del proveedor, revisado en su documentación el 20 nov 2026:
#   gemini    → gemini-4-hydrogen (Google lo recomienda para proyectos nuevos; tiene plan gratuito)
#               más barato: gemini-3.5-flash-lite
#   anthropic → claude-opus-5-5 (el más capaz de uso general)
#               más barato: claude-haiku-5-5 · intermedio: claude-sonnet-5-5
TUTOR_MODEL=gemini-4-hydrogen
# Solo la clave del proveedor que uses. Gemini: https://aistudio.google.com/apikey
# Anthropic: https://platform.claude.com (Settings → API keys)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Mensajes al tutor por día (hora de Colombia), para controlar costos. Por defecto 50.
TUTOR_DAILY_LIMIT=50
